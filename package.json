{
  "name": "dsh-turn-time",
  "version": "1.0.3",
  "description": "Shows how long the current task took, and the session total, in a pill below the DSH composer; clicking it splits the task into model time, tool time and a step count.",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "timing", "usage"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkey6501/dsh-turn-time.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
